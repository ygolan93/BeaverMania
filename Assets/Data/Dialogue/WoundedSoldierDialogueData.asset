  traderId: 'wounded_soldier'
  displayName: 'WoundedSoldier'
  dialogueLines:
  - 'Wounded Beaver: Ah hhrgh'
  - 'Player: Hey! Are you Ok there?'
  - 'Wounded Beaver: Just.. great'
  - 'Player: What happened here?'
  - 'Wounded Beaver: Wasps.'
  - 'Wounded Beaver: They took our entire town'
  - 'Wounded Beaver: Giant. Wasps.'
  - 'Wounded Beaver: Because why not. Right? '
  - 'Wounded Beaver: Some random bu!@#$%.'
  - 'Player: You look pretty bad.. I can take you to the camp.'
  - 'Wounded Beaver: Forget about me, sunshine. I''m a goner.'
  - 'Wounded Beaver: Take my hammers. '
  - 'Wounded Beaver: Have a blast'
  - 'Wounded Beaver: They work like magic though when you kneel.'
  - 'Player: ...Kneel?'
  - 'Wounded Beaver: You... you''ll see..'
  - 'Player:  Look, I can''t have them. These are y..'
  - 'Wounded Beaver: X_X'
  - 'Player:...Yours. '
  - 'Player: Oh s!@#.'
  - 'Player: ....'
  - 'Player: Ok.'
  - 'Player: It''s showtime.'
