  m_Script: {fileID: 11500000, guid: f7e8d9c0b1a2436587091e2d3f4a5b6c, type: 3}
  m_Name: SecondTraderDialogueData
  m_EditorClassIdentifier: 
  traderId: 'second_trader'
  displayName: 'SecondTrader'
  dialogueLines:
  - 'Watchtower Guard: Who''s there'
  - 'Player:Uh..  Delivery'
  - 'Watchtower Guard: Huh? I can''t remeber ordering any..'
  - 'Player: ...It''s honey. From your pal at the shady zone'
  - 'Watchtower Guard: Oh, I see. '
  - 'Player: He said you could guide me towards a.. treasure?'
  - 'Watchtower Guard: Hm? '
  - 'Player: Treasure. Booty. Something of value'
  - 'Watchtower Guard: I don''t know of any booty.'
  - 'Watchtower Guard: We''re not that much of a rich community in this area.'
  - 'Player: Come on, there must be something'
  - 'Watchtower Guard: You''re not even from around here.'
  - 'Watchtower Guard: Who are you, anyway? '
  - 'Watchtower Guard: Even if I would have known of such finding, why on earth would I tell.. you?'
  - 'Player: Long story short, I''m looking for my friend..'
  - 'Player: And there''s this Guard that''s on my way.'
  - 'Player: He''s not letting me through. '
  - 'Player: I need something.. Anything, to make him reconsider.'
  - 'Watchtower Guard: Hm yea that''s Bob. Don''t mind him. '
  - 'Watchtower Guard: He''s bitter and rude to everyone.'
  - 'Watchtower Guard: I''ve tried to befriend him once, can''t say that went well.'
  - 'Watchtower Guard: Anyway, I''ve got some.. intel on a stock pile at the farm.'
  - 'Player: ...The farm?'
  - 'Watchtower Guard: There''s an old small farm that''s located on the edge of the island'
  - 'Watchtower Guard: Guy''s running it has lost a few screws long ago'
  - 'Watchtower Guard: But with all the situation going on, they say his condition got worse.'
  - 'Player: You mean.. '
  - 'Watchtower Guard: I don''t mean anything. You haven''t heard it from me.'
  - 'Watchtower Guard: If I were you, I would n-e-v-e-r consider going there and check his barn.'
  - 'Watchtower Guard: Do you... understand what I''m saying?'
  - 'Player: I think so. '
  - 'Player: Hm.. Thanks for "nothing".'
  - 'Watchtower Guard: Don''t mention it.'
  - 'Watchtower Seriously, Don''t.'
  isBossDialogue: 0
  textSpeed: 0
  advanceObjectiveOnEnd: 1
  hasShop: 1
