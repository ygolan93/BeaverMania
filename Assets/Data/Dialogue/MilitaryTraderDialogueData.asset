  m_Script: {fileID: 11500000, guid: f7e8d9c0b1a2436587091e2d3f4a5b6c, type: 3}
  m_Name: MilitaryTraderDialogueData
  m_EditorClassIdentifier: 
  traderId: 'military_trader'
  displayName: 'MilitaryTrader'
  dialogueLines:
  - 'Player: Excuse me'
  - 'Player: How do I get to the other side?'
  - 'Military Trader: You don''t. You grow a brains and go the other way.'
  - 'Military Trader: Who let you in anyway?'
  - 'Player: hm...'
  - 'Player: Don''t tell anyone..'
  - 'Player: But I''m actually from the military police.'
  - 'Player: I''m here to do my, uh, annual inspection, and uh..'
  - 'Military Trader: ...Yea?'
  - 'Player: You passed! You passed.'
  - 'Military Trader: ....is that so?'
  - 'Military Trader: Lucky me.'
  - 'Player: Tell me uh..'
  - 'Player: Soldier.'
  - 'Player: What is your rank?'
  - 'Military Trader: You''re pretty bad at it.'
  - 'Military Trader: But I''m kind of amused.'
  - 'Player: Dude, just tell me how to get to the other side and you won''t see me again.'
  - 'Military Trader: But what if I do want to see you again?'
  - 'Player: ...?'
  - 'Military Trader: Relax, I''m just messing with you. You''re so naive.'
  - 'Military Trader: Anyway.. there''s this live cloud that''s been traveling on and off for quite a while'
  - 'Military Trader: From here to Rodant Heights (RIP).'
  - 'Military Trader: Once you''ll reach the other side just take the elevator.'
  - 'Military Trader: It''s the only thing we could save from the wasps, so it''s still working.'
  - 'Player: I see. '
  - 'Player: Thanks, appreciate it'
  isBossDialogue: 0
  textSpeed: 0
  advanceObjectiveOnEnd: 1
  hasShop: 1
