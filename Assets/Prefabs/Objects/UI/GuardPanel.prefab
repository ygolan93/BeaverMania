--- !u!114 &8164622903955744022
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6001246799503534448}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3c53d8ec40a9cf4081d0219df78e083, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Player: {fileID: 0}
  PlayerObjective: {fileID: 0}
  textComponent: {fileID: 1839694222525919277}
  ContinueButton: {fileID: 3707801176505235828}
  SkipButton: {fileID: 9111363594052116932}
  panel: {fileID: 5594286046093198402}
  Merchant: {fileID: 0}
  lines:
  - 'Guard: No traspassing. Turn on your way.'
  - 'Player: I need to get throguh.'
  - 'Guard: Why?'
  - 'Player: I need to reach to the camp.'
  - 'Guard: They have enough recruits. '
  - 'Guard:  Besides, I can tell you''re no local.'
  - 'Player: I have no intentions to enlist..'
  - 'Player: I just need to get to Rodant Heights.'
  - 'Guard: Oh, so you have a death wish. Is that it?'
  - 'Player: I can take care of myself, Just let me through.'
  - 'Guard: Sure you do.'
  - 'Guard: What are you gonna do up there anyway?'
  - 'Player: Looking for my friend.'
  - 'Guard: There''s no way your friend is still up there.'
  - 'Player: What do you mean?'
  - 'Guard: Either he ran away, or long gone dead.'
  - 'Player: I''ll be the judge of that.'
  - 'Guard: Oh I see what''s going on around here..'
  - 'Guard: You think you''re the main character or somethng?'
  - 'Player: ..What?'
  - 'Guard: You''re gonna die, idiot.'
  - 'Player: Let me through.'
  - 'Guard: Can''t do.'
  - 'Player: Why?'
  - 'Guard: Because it''s my job. This barrier exists for a reason.'
  - 'Guard: Why do you think beavertown still exist?'
  - 'Player:  I''ve just been attacked by several wasps on my way here.'
  - 'Guard: And?'
  - 'Player: That barrier is not doing a great job.'
  - 'Player: Infact, I think you''re delusional that you''re making any difference.'
  - 'Player: Is that why they placed you here?'
  - 'Player: Or was it actually your choice?'
  - 'Guard: ...'
  - 'Guard: That attitude won''t get you far.'
  - 'Player: for rodants sake, what do you want?'
  - 'Guard: What do I want..?'
  - 'Player: Yea. What would make you letting me in?'
  - 'Guard: ...'
  - 'Guard: Bring me something rare and I might reconsider'
  - 'Player: Like what'
  - 'Guard: Like go figure.'
  - 'Guard: Have you brought my gold?'
  textSpeed: 0
  isBoss: 0
