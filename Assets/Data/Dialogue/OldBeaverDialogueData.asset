  m_Script: {fileID: 11500000, guid: f7e8d9c0b1a2436587091e2d3f4a5b6c, type: 3}
  m_Name: OldBeaverDialogueData
  m_EditorClassIdentifier: 
  traderId: 'old_beaver'
  displayName: 'OldBeaver'
  dialogueLines:
  - 'Player: Uh, Excuse me?'
  - 'Old Beaver: Hm..?'
  - 'Player: What is this place?'
  - 'Old Beaver: You stand at Beaverius Villege, have you missed the sign?'
  - 'Player: What sign?'
  - 'Old Beaver: What sign? The big one at the..'
  - 'Old Beaver: Ugh, that useless Borris. I''ve told him to.. Nevermind.'
  - 'Old Beaver: What is your name, young lad?'
  - 'Player: Ottis'
  - 'Old Beaver: Ottis... I suppose you''re not from around.'
  - 'Player: ...You''re not wrong.'
  - 'Old Beaver: I see. '
  - 'Old Beaver: So what does a young foreign otter doing in a town of beavers?'
  - 'Player: I''m looking for my friend. He used to live around here..'
  - 'Player:.. but I haven''t heared from him for the past few weeks.'
  - 'Old Beaver: Hm.. Does he have a name?'
  - 'Player: It''s Beavus.'
  - 'Old Beaver: Oh.  I know him, good fella.'
  - 'Old Beaver: I''m sorry son.'
  - 'Player: What do you mean?'
  - 'Old Beaver: Our community has been under a malicious attack for the past few months.'
  - 'Old Beaver: Many have lost their Homes. and their lives.'
  - 'Old Beaver: We have lost contact with our neighbours at RodantHeights, up at the mountains'
  - 'Old Beaver: As far as I remember, your friend Beavus lives there.'
  - 'Old Beaver: Nobody dares to go up there to check on them.'
  - 'Player: What... What happend?'
  - 'Old Beaver: The scorpion king has took seat inside their water aquifer.'
  - ' Old Beaver: He sends his vile wasp minions across the islands, to cause havoc.'
  - 'Old Beaver: The only thing that hold these devil breed creatures is our sons at the camp.'
  - 'Old Beaver: But hear me out young lad...Nobody dares to say it out loud but..'
  - 'Old Beaver: We are loosing.'
  - 'Old Beaver: I sugguest you turn on your way. '
  - 'Player: ..'
  - 'Player: I appreiciate the offer.'
  - 'Player: Now, which way is to RodantHeights'
  - 'Old Beaver: Stubborn, are we?'
  - 'Old Beaver: You will have to go through the garden in order to get up at the camp'
  - 'Old Beaver: From there, you''ll have to find a way to cross to the other side.'
  - 'Old Beaver: You''re doing a grave mistake, son.'
  - 'Old Beaver: But I wish you luck.'
  isBossDialogue: 0
  textSpeed: 0
  advanceObjectiveOnEnd: 1
  hasShop: 1
