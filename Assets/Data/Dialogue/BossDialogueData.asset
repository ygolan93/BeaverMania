  m_Name: BossDialogueData
  m_EditorClassIdentifier: 
  traderId: boss
  displayName: Boss
  dialogueLines:
  - 'Sorpion: Hssss....'
  - 'Player: (What hell on earth...?)'
  - 'Sorpion: Who dares to disturb my sleep?'
  - 'Scorpion: I smelll..... '
  - 'Scorpion: BREAKFAST!'
  - 'Scorpion: Tell me your name, Tiny snack, and I might make it quick and less
    painful.'
  - 'Player: Where''s my friend, you big fat ugly bastard?'
  - 'Scorpion: hmmm.. The meal got some nerves...'
  - 'Player: Where is he?!'
  - 'Scorpion: "Where is he, Where is he". Do you think I keep track of what or who
    I consume?'
  - 'Scorpion: I''ve devoured countless of beavers! Destroyed Countless of towns!'
  - 'Scorpion: I''m not on some stupid diet. I''m trying to gain weight.'
  - 'Scorpion: Although... now that I look at you.. you look a bit scrawny.'
  - 'Scorpion: I doubt if the effort of chewing you up would be any worth it.'
  - 'Player: The only thing you''re gonna chew is my fist!'
  - 'Scorpion: Oh my... your.. fist?'
  - 'Scorpion: Heh. you fool.'
  - 'Scorpion: Your arrogance shall be your grave.'
  - 'Player: Last chance! Release my friend.'
  - 'Scorpion: Come and get him..'
  isBossDialogue: 1
  textSpeed: 0
  advanceObjectiveOnEnd: 1
  hasShop: 0
