--- !u!114 &324567499210214987
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5178875608432823767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3c53d8ec40a9cf4081d0219df78e083, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Player: {fileID: 0}
  PlayerObjective: {fileID: 0}
  textComponent: {fileID: 8353364675871935727}
  ContinueButton: {fileID: 1839184044612269319}
  SkipButton: {fileID: 8018249439457218811}
  panel: {fileID: 687677073547854064}
  dialogueData: {fileID: 11400000, guid: a5a95eef33b1469ba59db348a7494d62, type: 2}
  Merchant: {fileID: 0}
  lines:
  - 'Player: Excuse me'
  - 'Player: How do I get to the other side?'
  - 'Military Trader: You don''t. You grow a brains and go the other way.'
  - 'Military Trader: Who let you in anyway?'
  - 'Player: hm...'
  - 'Player: Don''t tell anyone..'
  - 'Player: But I''m actually from the military police.'
  - 'Player: I''m here to do my, uh, annual inspection, and uh..'
  - 'Military Trader: ...Yea?'
  - 'Player: You passed! You passed.'
  - 'Military Trader: ....is that so?'
  - 'Military Trader: Lucky me.'
  - 'Player: Tell me uh..'
  - 'Player: Soldier.'
  - 'Player: What is your rank?'
  - 'Military Trader: You''re pretty bad at it.'
  - 'Military Trader: But I''m kind of amused.'
  - 'Player: Dude, just tell me how to get to the other side and you won''t see me
    again.'
  - 'Military Trader: But what if I do want to see you again?'
  - 'Player: ...?'
  - 'Military Trader: Relax, I''m just messing with you. You''re so naive.'
  - 'Military Trader: Anyway.. there''s this live cloud that''s been traveling on
    and off for quite a while'
  - 'Military Trader: From here to Rodant Heights (RIP).'
  - 'Military Trader: Once you''ll reach the other side just take the elevator.'
  - 'Military Trader: It''s the only thing we could save from the wasps, so it''s
    still working.'
  - 'Player: I see. '
  - 'Player: Thanks, appreciate it'
  textSpeed: 0
  isBoss: 0
