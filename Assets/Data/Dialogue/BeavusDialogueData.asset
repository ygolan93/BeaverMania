  m_Script: {fileID: 11500000, guid: f7e8d9c0b1a2436587091e2d3f4a5b6c, type: 3}
  m_Name: BeavusDialogueData
  m_EditorClassIdentifier: 
  traderId: 'beavus'
  displayName: 'Beavus'
  dialogueLines:
  - 'Beavus: Who.. who''s there?'
  - 'Player: Beev! It''s me! Ottis!'
  - 'Beavus: Ottis...?'
  - 'Player: You''re right, mate?'
  - 'Beavus: What are you doing here?'
  - 'Player: What do you mean? I''m here to get you outta here'
  - 'Beavus: No.. you can''t..'
  - 'Beavus: It''s.. it''s all my fault.'
  - 'Player: What do you mean..?'
  - ' I was the one to awaken the Scorpion King.n King.'
  - 'Player: ...What?'
  - 'Beavus: It was an accident!'
  - 'Beavus: Listen... Rodant Heights have suffered a long period of drought.'
  - 'Beavus: People started leaving.'
  - 'Beavus: First to leave were the farmers. Then the police forces.'
  - 'Beavus: Then my barber, my ex-wife...'
  - 'Beavus: So.. The other day I''ve found an ancient sorcery book. Out of nowhere!'
  - 'Beavus: I tried to look for a spell to bring back the rain and the crops...'
  - 'Beavus: Thought it could help  restoring life in our town.'
  - 'Beavus: But, I''ve made a mistake, and used the wrong spell..'
  - 'Beavus: I''ve opened the gates of hell.'
  - 'Beavus: And now my barber won''t answer my calls :('
  - 'Player: Good thing you have your priorities checked.'
  - 'Player: Where is that book?'
  - 'Beavus: It was around here... But it''s gone now.'
  - 'Beavus: As soon as this mayhem started, I''ve lost it.'
  - 'Beavus: It could be anywhere.'
  - 'Beavus: Please, just leave me be. I can''t show my face in town.'
  - 'Player: Sorry pal, can''t do that. You''re getting out of here'
  - 'Beavus: I can''t go back to town.'
  - 'Player: Who said anything about going back?'
  - 'Beavus: Then.. what do you have in mind?'
  - 'Player: We''re gonna fix it.'
  - 'Player: That book needs to be found.'
  - 'Player: And I might have an idea where to look'
  isBossDialogue: 0
  textSpeed: 0
  advanceObjectiveOnEnd: 1
  hasShop: 1
